---
import { getImage } from 'astro:assets';
import type { GalleryItem } from '../../data/galeria';
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';

interface Props {
  items: GalleryItem[];
}

const items = await Promise.all(
  Astro.props.items.map(async (item) => ({
    ...item,
    full: (await getImage({ src: item.image, width: 1600 })).src,
  })),
);

const navButton =
  'inline-flex size-12 items-center justify-center border border-gold-500/60 text-gold-500 transition-colors hover:bg-gold-500 hover:text-ink-950';
---

<ul class="mt-14 columns-1 gap-6 sm:columns-2 lg:columns-3" data-gallery>
  {
    items.map((item) => (
      <li class="mb-6 break-inside-avoid">
        <figure class="group">
          <button
            type="button"
            class="block w-full cursor-zoom-in overflow-hidden bg-ink-800"
            aria-label={`Ampliar: ${item.caption}`}
            data-full={item.full}
            data-alt={item.alt}
            data-caption={item.caption}
          >
            <Photo
              src={item.image}
              alt={item.alt}
              widths={[480, 720, 1080]}
              sizes="(min-width: 1024px) 31vw, (min-width: 640px) 48vw, 100vw"
              class="h-auto w-full transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            />
          </button>
          <figcaption class="mt-3 flex items-baseline gap-3 text-sm text-ivory-muted">
            <span class="size-1.5 shrink-0 translate-y-[-0.1em] rotate-45 bg-gold-500" aria-hidden="true" />
            {item.caption}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<dialog
  id="gallery-dialog"
  class="m-0 h-dvh max-h-none w-dvw max-w-none bg-transparent p-0 text-ivory backdrop:bg-ink-950/95"
  aria-label="Imagen ampliada"
>
  <div class="flex h-full flex-col px-4 py-4 sm:px-8 sm:py-6">
    <div class="flex items-center justify-between gap-4">
      <p class="font-accent text-2xl italic text-gold-500" aria-live="polite">
        <span data-current>1</span> / <span data-total>{items.length}</span>
      </p>
      <button type="button" class={navButton} data-close aria-label="Cerrar">
        <Icon name="close" />
      </button>
    </div>

    <div class="grid min-h-0 flex-1 grid-cols-[auto_minmax(0,1fr)_auto] grid-rows-[minmax(0,1fr)] items-center gap-3 py-4 sm:gap-6">
      <button type="button" class={navButton} data-prev aria-label="Imagen anterior">
        <Icon name="chevronLeft" class="size-6" />
      </button>
      <img
        class="mx-auto max-h-[calc(100dvh-14rem)] max-w-full object-contain outline outline-1 outline-offset-[6px] outline-gold-500/35"
        alt=""
        data-image
      />
      <button type="button" class={navButton} data-next aria-label="Imagen siguiente">
        <Icon name="chevronRight" class="size-6" />
      </button>
    </div>

    <p class="mx-auto max-w-2xl text-center text-ivory-muted" data-caption></p>
  </div>
</dialog>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery] button[data-full]'));
  const dialog = document.querySelector<HTMLDialogElement>('#gallery-dialog');

  if (dialog && buttons.length) {
    const image = dialog.querySelector<HTMLImageElement>('[data-image]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-caption]')!;
    const current = dialog.querySelector<HTMLElement>('[data-current]')!;
    let index = 0;
    let opener: HTMLButtonElement | null = null;

    const show = (next: number) => {
      index = (next + buttons.length) % buttons.length;
      const { full = '', alt = '', caption: text = '' } = buttons[index].dataset;
      image.src = full;
      image.alt = alt;
      caption.textContent = text;
      current.textContent = String(index + 1);
      [index - 1, index + 1].forEach((n) => {
        new Image().src = buttons[(n + buttons.length) % buttons.length].dataset.full ?? '';
      });
    };

    buttons.forEach((button, i) =>
      button.addEventListener('click', () => {
        opener = button;
        show(i);
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      }),
    );

    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      opener?.focus();
    });

    let startX = 0;
    dialog.addEventListener('touchstart', (event) => (startX = event.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (event) => {
      const delta = event.changedTouches[0].clientX - startX;
      if (Math.abs(delta) > 50) show(index + (delta < 0 ? 1 : -1));
    });
  }
</script>
