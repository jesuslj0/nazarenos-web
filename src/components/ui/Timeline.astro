---
import type { Hito } from '../../data/historia';
import Icon from './Icon.astro';

interface Props {
  items: Hito[];
  /** Hitos anteriores, plegados en la propia línea tras «Ver historia anterior». */
  previous?: Hito[];
  /** Lista sin línea propia, para anidarla dentro de otra cronología. */
  bare?: boolean;
}

const { items, previous = [], bare = false } = Astro.props;
---

<div class:list={['relative', !bare && 'border-l border-gold-500/35 pl-8 sm:pl-10']}>
  {
    previous.length > 0 && (
      <details class="group mb-10">
        <summary class="relative flex w-fit cursor-pointer list-none items-center gap-2 text-gold-500 select-none hover:text-gold-300 [&::-webkit-details-marker]:hidden">
          <span
            class="absolute -left-[2.35rem] top-1/2 size-2.5 -translate-y-1/2 rotate-45 border border-gold-500 bg-ink-950 group-open:bg-gold-500 sm:-left-[2.85rem]"
            aria-hidden="true"
          />
          <span class="font-accent text-2xl italic group-open:hidden">Ver historia anterior</span>
          <span class="hidden font-accent text-2xl italic group-open:inline">Ocultar historia anterior</span>
          <Icon
            name="chevronUp"
            class="size-5 rotate-180 motion-safe:transition-transform group-open:rotate-0"
          />
        </summary>
        <div class="mt-10">
          <Astro.self items={previous} bare />
        </div>
      </details>
    )
  }

  <ol class="space-y-10">
    {
      items.map((item) => (
        <li class="relative">
          <span
            class="absolute -left-[2.35rem] top-2.5 size-2.5 rotate-45 bg-gold-500 sm:-left-[2.85rem]"
            aria-hidden="true"
          />
          <p class="font-accent text-3xl italic text-gold-500">{item.when}</p>
          <h3 class="mt-1 text-xl font-semibold not-italic">{item.title}</h3>
          <p class="mt-2 max-w-2xl text-ivory-muted">{item.text}</p>
        </li>
      ))
    }
  </ol>
</div>
