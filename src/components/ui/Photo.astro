---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  style?: string;
}

/*
 * Imagen responsive con un ancho máximo explícito. No se leen propiedades de `src`:
 * Astro interpreta cualquier lectura como uso directo y conservaría el original (hasta 21 MB) en `dist`.
 */
const { src, widths = [480, 800, 1200, 1600], ...rest } = Astro.props;
---

<Image src={src} width={Math.max(...widths)} widths={widths} {...rest} />
