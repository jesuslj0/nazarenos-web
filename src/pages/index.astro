---
import Photo from '../components/ui/Photo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import NewsCard from '../components/news/NewsCard.astro';
import EventRow from '../components/events/EventRow.astro';
import { images } from '../data/images';
import { site } from '../data/site';
import { titulares } from '../data/titulares';
import { sortedNews, splitEvents } from '../utils/collections';

const [featured, ...others] = sortedNews().slice(0, 3);
const { upcoming } = splitEvents();
---

<BaseLayout image={images.procesionNazareno}>
  <section class="relative isolate overflow-hidden bg-ink-950">
    <div class="absolute inset-0 -z-10 opacity-90 lg:left-[28%] lg:[mask-image:linear-gradient(to_right,transparent,black_42%)]">
      <Photo
        src={images.procesionNazareno}
        alt="Procesión nocturna de Nuestro Padre Jesús Nazareno en una plaza de El Bonillo: el paso iluminado avanza entre nazarenos morados."
        widths={[640, 1000]}
        sizes="(min-width: 1024px) 72vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="size-full object-cover object-[55%_12%]"
      />
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950 via-ink-950/75 via-40% to-ink-950/30 lg:via-ink-950/60 lg:to-transparent" aria-hidden="true"></div>

    <div class="container-page flex min-h-[calc(100svh-4.5rem)] flex-col justify-end pb-14 pt-40 sm:pb-20 lg:justify-center lg:pb-24 lg:pt-24">
      <p class="eyebrow">El Bonillo · Albacete · Desde {site.founded}</p>
      <h1 class="display-title mt-7 text-[clamp(2.9rem,8.5vw,6.5rem)] leading-[0.98]">
        <span class="block text-[0.45em] font-normal tracking-wide text-ivory-muted">Hermandad de</span>
        Nuestro Padre
        <span class="gold-text block">Jesús Nazareno</span>
      </h1>
      <p class="lede mt-8 max-w-lg">
        Una hermandad y una agrupación musical al servicio de la devoción de El Bonillo. Historia, tradición y
        música a los pies del Nazareno.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <ButtonLink href="/hermandad/">Conocer la hermandad</ButtonLink>
        <ButtonLink href="/agrupacion/" variant="outline">Agrupación musical</ButtonLink>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="presentacion">
    <div class="container-page grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-7">
        <p class="eyebrow">La hermandad</p>
        <h2 id="presentacion" class="section-title mt-5">
          Más de dos siglos <span class="gold-text">caminando</span> con el Nazareno
        </h2>
        <div class="prose-body mt-8 max-w-2xl">
          <p>
            La cofradía Nuestro Padre Jesús Nazareno es una de las más antiguas que recorren las calles de El
            Bonillo en Semana Santa y, por el número de sus integrantes y su gran tradición, una referencia
            obligada de la Semana Santa bonillera.
          </p>
          <p>
            Fundada en {site.founded}, custodia tres imágenes —Nuestro Padre Jesús Nazareno, Nuestra Señora de la
            Piedad y Jesús Resucitado— que resumen el misterio de la Pasión, Muerte y Resurrección.
          </p>
        </div>

        <dl class="mt-12 grid max-w-2xl grid-cols-3 gap-6 border-t border-gold-500/30 pt-8">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-ivory-muted">Fundación</dt>
            <dd class="mt-1 font-display text-4xl text-gold-500 sm:text-5xl">{site.founded}</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-ivory-muted">Hermanos</dt>
            <dd class="mt-1 font-display text-4xl text-gold-500 sm:text-5xl">≈ 400</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-ivory-muted">Músicos</dt>
            <dd class="mt-1 font-display text-4xl text-gold-500 sm:text-5xl">≈ 60</dd>
          </div>
        </dl>
        <p class="mt-3 text-xs text-ivory-muted/80">Cifras aproximadas según la reseña histórica de la hermandad.</p>

        <div class="mt-10">
          <ButtonLink href="/hermandad/" variant="outline">Historia y titulares</ButtonLink>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-sm pb-10 lg:col-span-5 lg:max-w-md lg:pb-12">
        <div class="aspect-[4/5] [mask-image:radial-gradient(ellipse_closest-side,black_70%,transparent_100%)]">
          <Photo
            src={images.escudoAgrupacion}
            alt="Escudo de la agrupación musical: monograma dorado con las iniciales H, J y N bajo una corona real, entrelazado con una corona de espinas y tres clavos, sobre fondo morado."
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 28rem, 24rem"
            class="size-full object-cover object-[50%_6%]"
          />
        </div>
        <Photo
          src={images.escudoHermandad}
          alt="Escudo de la hermandad: relieve en bronce de Jesús Nazareno abrazado a la cruz, rodeado por la corona de espinas."
          widths={[240, 400, 560]}
          sizes="(min-width: 640px) 11rem, 9rem"
          class="absolute bottom-0 -right-3 w-36 drop-shadow-[0_8px_18px_rgb(0_0_0/0.55)] sm:-right-10 sm:w-44"
        />
      </div>
    </div>
  </section>

  <section class="section border-y border-gold-500/20 bg-ink-950" aria-labelledby="titulares">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
        <SectionHeading eyebrow="Nuestros titulares">
          <span id="titulares">Tres imágenes, un solo <span class="gold-text">misterio</span></span>
        </SectionHeading>
        <a href="/hermandad/#titulares" class="link-quiet shrink-0 text-sm font-semibold uppercase tracking-[0.16em]">
          Ver todos los titulares
        </a>
      </div>

      <ul class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-6 lg:gap-10">
        {
          titulares.map((t) => (
            <li>
              <a href={`/hermandad/#${t.slug}`} class="group block">
                <div class="aspect-[3/4] overflow-hidden bg-ink-800 outline outline-1 outline-offset-4 outline-gold-500/35">
                  <Photo
                    src={t.image}
                    alt={t.imageAlt}
                    widths={[360, 560, 800]}
                    sizes="(min-width: 640px) 30vw, 100vw"
                    class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                  />
                </div>
                <h3 class="mt-7 text-2xl transition-colors group-hover:text-gold-300">{t.name}</h3>
                <p class="mt-1 text-xs font-semibold uppercase tracking-[0.2em] text-gold-500">{t.title}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-violet-600" aria-labelledby="agrupacion">
    <div class="grid lg:grid-cols-2">
      <div class="relative min-h-[18rem] lg:min-h-[34rem]">
        <Photo
          src={images.capillaGranPoder}
          alt="La agrupación musical al completo, de uniforme negro con detalles morados, ante el retablo dorado del templo."
          widths={[640, 960, 1400]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="absolute inset-0 size-full object-cover object-[50%_65%]"
        />
      </div>
      <div class="flex flex-col justify-center px-5 py-16 sm:px-10 lg:px-16 lg:py-24 xl:px-24">
        <p class="eyebrow text-gold-300">Agrupación musical</p>
        <h2 id="agrupacion" class="section-title mt-5">
          Música, sentimiento y <span class="gold-text">pasión</span>
        </h2>
        <p class="mt-7 max-w-lg text-lg text-violet-200">
          De una humilde banda de cornetas y tambores a una agrupación de reconocido prestigio en el mundo
          cofrade, con unos 60 componentes y un repertorio de grandes marchas procesionales.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <ButtonLink href="/agrupacion/">Conocer la agrupación</ButtonLink>
          <ButtonLink href="/contacto/" variant="outline">Contratación</ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="noticias">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
        <SectionHeading eyebrow="Actualidad">
          <span id="noticias">Últimas <span class="gold-text">noticias</span></span>
        </SectionHeading>
        <a href="/actualidad/" class="link-quiet shrink-0 text-sm font-semibold uppercase tracking-[0.16em]">
          Todas las noticias
        </a>
      </div>

      <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-14">
        {featured && (
          <div class="lg:col-span-7">
            <NewsCard item={featured} variant="featured" />
          </div>
        )}
        <div class="space-y-10 lg:col-span-5">
          {others.map((item) => <NewsCard item={item} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="section border-t border-gold-500/20 bg-ink-950" aria-labelledby="eventos">
    <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <SectionHeading eyebrow="Agenda">
          <span id="eventos">Próximos <span class="gold-text">eventos</span></span>
        </SectionHeading>
        <div class="mt-8">
          <ButtonLink href="/actualidad/#eventos" variant="outline">Ver agenda completa</ButtonLink>
        </div>
      </div>
      <div class="lg:col-span-8">
        {
          upcoming.length > 0 ? (
            upcoming.slice(0, 3).map((event) => <EventRow event={event} />)
          ) : (
            <p class="border-t border-gold-500/35 pt-7 text-ivory-muted">
              No hay eventos programados por el momento.
            </p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
