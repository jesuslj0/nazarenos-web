---
import GalleryGrid from '../components/gallery/GalleryGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { archivo, gallery } from '../data/galeria';
import { images } from '../data/images';
---

<BaseLayout
  title="Galería e Historia"
  description="Galería de imágenes y archivo histórico de la Hermandad de Nuestro Padre Jesús Nazareno y de su agrupación musical."
  image={images.actoSevilla}
>
  <PageHero eyebrow="Galería e Historia">
    La memoria en <span class="gold-text">imágenes</span>
    <Fragment slot="lede">
      Fotografías de la hermandad y de la agrupación musical, junto a las referencias documentales de su historia.
    </Fragment>
  </PageHero>

  <section class="section" aria-labelledby="galeria">
    <div class="container-page">
      <SectionHeading eyebrow="Galería">
        <span id="galeria">Imágenes de la <span class="gold-text">hermandad</span></span>
        <Fragment slot="intro">
          Una primera selección de fotografías. <span class="pending">[Pendiente: fechas, autoría y nuevas fotografías]</span>
        </Fragment>
      </SectionHeading>

      <GalleryGrid items={gallery} />
    </div>
  </section>

  <section class="section border-t border-gold-500/20 bg-ink-950" aria-labelledby="archivo">
    <div class="container-page grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow="Archivos históricos">
          <span id="archivo">Documentos y <span class="gold-text">publicaciones</span></span>
          <Fragment slot="intro">
            Referencias recogidas en la reseña histórica de la hermandad.
          </Fragment>
        </SectionHeading>
        <p class="mt-8 text-sm text-ivory-muted">
          <span class="pending">[Pendiente: documentos digitalizados, fotografías antiguas y archivo de la hermandad]</span>
        </p>
      </div>
      <ol class="lg:col-span-7">
        {
          archivo.map((a) => (
            <li class="grid grid-cols-[4.5rem_1fr] gap-5 border-t border-gold-500/25 py-6 last:border-b sm:grid-cols-[6rem_1fr]">
              <span class="font-accent text-3xl italic text-gold-500">{a.when}</span>
              <div>
                <h3 class="text-2xl">{a.title}</h3>
                <p class="mt-2 text-ivory-muted">{a.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>
