---
import Photo from '../components/ui/Photo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Icon from '../components/ui/Icon.astro';
import Timeline from '../components/ui/Timeline.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import FormacionMapa from '../components/agrupacion/FormacionMapa.astro';
import { actuaciones } from '../data/actuaciones';
import { formacion } from '../data/formacion';
import { images } from '../data/images';
import { agrupacionHistoriaAnterior, agrupacionHitos, agrupacionResumen, repertorio } from '../data/historia';
import { contact, site } from '../data/site';

const [campoCriptana, torredonjimeno, valencia] = actuaciones;

const leyenda = [
  {
    clave: 'nueva',
    icon: 'sparkles',
    color: 'text-gold-500',
    boton: 'hover:border-gold-500/60 aria-pressed:border-gold-500 aria-pressed:bg-gold-500/15',
    label: 'Nueva incorporación',
  },
  {
    clave: 'propia',
    icon: 'heart',
    color: 'text-lilac-300',
    boton: 'hover:border-lilac-300/60 aria-pressed:border-lilac-300 aria-pressed:bg-lilac-300/15',
    label: 'Marcha propia',
  },
] as const;
---

<BaseLayout
  title="Agrupación Musical"
  description="Historia, repertorio y contratación de la Agrupación Musical Nuestro Padre Jesús Nazareno de El Bonillo."
  image={images.presentacionTrajeGala}
>
  <PageHero
    eyebrow={site.agrupacion.shortName}
    image={images.presentacionTrajeGala}
    imageAlt="Fotografía de grupo de la agrupación musical con el traje de gala, con tambores y bombos en primer término ante un retablo dorado."
    imagePosition="50% 0%"
    imageLeft="36%"
    imageWidths={[800, 1280, 1600]}
  >
    <span class="block text-[0.8em]">Agrupación Musical</span> <span class="gold-text bg-linear-to-r from-gold-500 from-20% via-gold-300 via-55% to-lilac-300 to-85% bg-clip-text pr-[0.1em] text-transparent">Nuestro Padre Jesús Nazareno</span>
    <Fragment slot="lede">Música, sentimiento y pasión a los pies del Nazareno.</Fragment>
  </PageHero>

  <section class="section" aria-labelledby="presentacion">
    <div class="container-page grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-7">
        <SectionHeading eyebrow="Presentación">
          <span id="presentacion">Una banda con <span class="gold-text">carácter</span> propio</span>
        </SectionHeading>
        <div class="prose-body mt-8 max-w-2xl">
          {agrupacionResumen.map((p) => <p>{p}</p>)}
          <p>
            En la actualidad la agrupación está compuesta por unos 60 componentes, la mayoría con conocimientos
            musicales, y es una banda de reconocido prestigio en el mundo musical cofrade.
          </p>
        </div>
        <div class="mt-10 flex flex-wrap gap-4">
          <ButtonLink href="#repertorio"><Icon name="music" />Ver repertorio</ButtonLink>
          <ButtonLink href="#contratacion" variant="outline"><Icon name="handshake" />Contratación</ButtonLink>
        </div>
      </div>
      <div class="mx-auto w-full max-w-sm lg:col-span-5 lg:max-w-none">
        <div class="aspect-[3/4] overflow-hidden bg-ink-800 outline outline-1 outline-offset-[10px] outline-gold-500/35">
          <Photo
            src={images.estandarte}
            alt="Detalle del estandarte de la agrupación: terciopelo morado con el monograma HJN bordado en oro y la leyenda «A. M. Nuestro Padre Jesús Nazareno, El Bonillo»."
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 40vw, 24rem"
            class="size-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="formacion" class="section scroll-mt-20 border-y border-gold-500/20 bg-ink-950" aria-labelledby="formacion-titulo">
    <div class="container-page">
      <SectionHeading eyebrow="Integrantes">
        <span id="formacion-titulo">Nuestra <span class="gold-text">formación</span></span>
        <Fragment slot="intro">
          Os invitamos a conocer a los músicos que dan voz a la agrupación y la riqueza de instrumentos que
          componen su sonido, del redoble del tambor al timbre dorado del metal.
        </Fragment>
      </SectionHeading>

      <div class="mt-12">
        <FormacionMapa secciones={formacion} />
      </div>
    </div>
  </section>

  <section id="repertorio" class="section scroll-mt-20" aria-labelledby="repertorio-titulo">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
        <SectionHeading eyebrow="Repertorio 2026">
          <span id="repertorio-titulo">Marchas <span class="gold-text">procesionales</span></span>
          <Fragment slot="intro">
            Del clásico «Costaleros Gitanos» o «Oración» a grandes marchas de prestigiosos compositores,
            conjugando arte, composición y armonía.
          </Fragment>
        </SectionHeading>
        <ul class="flex shrink-0 flex-wrap gap-x-3 gap-y-2 text-sm text-ivory-muted" aria-label="Leyenda: destacar marchas">
          {
            leyenda.map((item) => (
              <li>
                <button
                  type="button"
                  data-destacar={item.clave}
                  aria-pressed="false"
                  class:list={['flex items-center gap-2 border border-transparent px-3 py-1.5 transition-colors hover:text-ivory aria-pressed:text-ivory', item.boton]}
                >
                  <Icon name={item.icon} class={`size-4 ${item.color}`} />
                  {item.label}
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      <ol class="mt-12 gap-x-12 sm:columns-2 lg:columns-3" data-repertorio>
        {
          repertorio.map((obra) => (
            <li
              class="group -mx-2 break-inside-avoid border-t border-gold-500/25 px-2 py-3 transition duration-300 data-[dim]:opacity-30 data-[on=nueva]:border-gold-500 data-[on=nueva]:bg-gold-500/10 data-[on=propia]:border-lilac-300 data-[on=propia]:bg-lilac-300/10"
              data-nueva={obra.nueva || undefined}
              data-propia={obra.propia || undefined}
            >
              <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
                <span class="font-display text-lg leading-tight transition-colors duration-300 group-data-[on=nueva]:text-gold-300 group-data-[on=propia]:text-lilac-200 sm:text-xl">{obra.title}</span>
                {obra.nueva && (
                  <span class="inline-flex text-gold-500" title="Nueva incorporación">
                    <Icon name="sparkles" class="size-4" />
                    <span class="sr-only">Nueva incorporación</span>
                  </span>
                )}
                {obra.propia && (
                  <span class="inline-flex text-lilac-300" title="Marcha propia">
                    <Icon name="heart" class="size-4" />
                    <span class="sr-only">Marcha propia</span>
                  </span>
                )}
              </p>
              <p class="mt-0.5 text-xs text-ivory-muted">{obra.composer}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section border-y border-gold-500/20 bg-ink-950" aria-labelledby="historia">
    <div class="container-page grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <SectionHeading eyebrow="Historia">
            <span id="historia">De las cornetas y tambores a la <span class="gold-text">agrupación</span></span>
          </SectionHeading>
          <p class="mt-8 text-sm text-ivory-muted">
            <span class="pending">[Pendiente: año exacto de fundación de la agrupación]</span>
          </p>
        </div>
      </div>
      <div class="lg:col-span-8">
        <Timeline items={agrupacionHitos} previous={agrupacionHistoriaAnterior} />
      </div>
    </div>
  </section>

  <section class="section border-y border-gold-500/20 bg-ink-800/50" aria-labelledby="actividad">
    <div class="container-page">
      <SectionHeading eyebrow="Actuaciones y actividad musical">
        <span id="actividad">Más allá de <span class="gold-text">El Bonillo</span></span>
        <Fragment slot="intro">
          Gracias a su uniforme y a la mejora de su instrumental, la agrupación ha actuado fuera de la localidad,
          sobrepasando el ámbito castellano-manchego, y participa año tras año en distintos certámenes y desfiles.
        </Fragment>
      </SectionHeading>

      <div class="mt-14 grid gap-6 lg:grid-cols-12">
        <figure class="lg:col-span-7">
          <Photo
            src={images.capillaSevillaAerea}
            alt="Vista cenital de la agrupación musical interpretando en una iglesia, con el público en los bancos y el retablo al fondo."
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 58vw, 100vw"
            class="aspect-[3/2] w-full object-cover"
          />
          <figcaption class="mt-3 text-sm text-ivory-muted">Parroquia de San Lorenzo, Sevilla · 7 de febrero de 2026</figcaption>
        </figure>
        <div class="flex flex-col justify-between gap-6 lg:col-span-5">
          <figure>
            <Photo
              src={images.actoSevilla}
              alt="La agrupación interpretando al aire libre, vista desde detrás del director, con trompetas, fliscornos y el estandarte a la derecha."
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              class="aspect-[3/2] w-full object-cover"
            />
            <figcaption class="mt-3 text-sm text-ivory-muted">XI Certamen benéfico de Consuelo y Esperanza, Sevilla Este · 8 de febrero de 2026</figcaption>
          </figure>
          <div class="prose-body">
            <p><span class="pending">[Pendiente: palmarés y actuaciones destacadas]</span></p>
          </div>
        </div>
      </div>

      <div class="mt-16">
        <div class="grid gap-6 sm:grid-cols-2">
          {
            campoCriptana.photos.map((p) => (
              <Photo
                src={p.image}
                alt={p.alt}
                widths={[480, 720, 960, 1280]}
                sizes="(min-width: 1024px) 38rem, (min-width: 640px) 50vw, 100vw"
                class:list={['aspect-[3/2] w-full object-cover', p.class]}
              />
            ))
          }
        </div>
        <div class="mt-5 max-w-3xl">
          <p class="eyebrow">{campoCriptana.when}</p>
          <p class="mt-3 font-display text-xl leading-snug sm:text-2xl">{campoCriptana.title}</p>
          <p class="mt-1 text-sm text-ivory-muted">{campoCriptana.place}</p>
          {campoCriptana.details.map((d) => <p class="mt-2 text-sm text-ivory-muted">{d}</p>)}
        </div>
      </div>

      <div class="mt-16 grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
        <Photo
          src={torredonjimeno.photos[0].image}
          alt={torredonjimeno.photos[0].alt}
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 38vw, (min-width: 640px) 28rem, 100vw"
          class="mx-auto aspect-[4/5] w-full max-w-md object-cover object-[50%_55%] lg:col-span-5 lg:max-w-none"
        />
        <div class="lg:col-span-7">
          <p class="eyebrow">{torredonjimeno.when}</p>
          <p class="mt-3 font-display text-2xl leading-snug sm:text-3xl">{torredonjimeno.title}</p>
          <p class="mt-1 text-sm text-ivory-muted">{torredonjimeno.place}</p>
          <div class="prose-body mt-6">
            {torredonjimeno.details.map((d) => <p>{d}</p>)}
          </div>
        </div>
      </div>

      <div class="mt-16 grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
        <Photo
          src={valencia.photos[0].image}
          alt={valencia.photos[0].alt}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          class="aspect-[3/2] w-full object-cover lg:order-2 lg:col-span-7"
        />
        <div class="lg:order-1 lg:col-span-5">
          <p class="eyebrow">{valencia.when}</p>
          <p class="mt-3 font-display text-2xl leading-snug sm:text-3xl">{valencia.title}</p>
          <p class="mt-1 text-sm text-ivory-muted">{valencia.place}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="contratacion" class="section scroll-mt-20" aria-labelledby="contratacion-titulo">
    <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-6">
        <SectionHeading eyebrow="Contacto y contratación">
          <span id="contratacion-titulo">¿Quieres contar con la <span class="gold-text">agrupación</span>?</span>
        </SectionHeading>
      </div>
      <div class="lg:col-span-6">
        <div class="prose-body">
          <p>
            {
              contact.contratacion ? (
                contact.contratacion
              ) : (
                <span class="pending">[Pendiente: condiciones y procedimiento de contratación]</span>
              )
            }
          </p>
          <p>Mientras tanto, puedes escribirnos a través de nuestras redes sociales o de la página de contacto.</p>
        </div>
        <div class="mt-8">
          <ButtonLink href="/contacto/"><Icon name="mail" />Ir a contacto</ButtonLink>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const lista = document.querySelector<HTMLElement>('[data-repertorio]');

  if (lista) {
    const marchas = Array.from(lista.querySelectorAll<HTMLElement>('li'));
    const botones = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-destacar]'));
    let fijado: string | null = null;
    let sobrevolado: string | null = null;

    const pintar = () => {
      const activo = sobrevolado ?? fijado;
      marchas.forEach((m) => {
        const coincide = activo !== null && m.hasAttribute(`data-${activo}`);
        if (coincide && activo) m.setAttribute('data-on', activo);
        else m.removeAttribute('data-on');
        m.toggleAttribute('data-dim', activo !== null && !coincide);
      });
      botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.destacar === fijado)));
    };

    botones.forEach((b) => {
      b.addEventListener('mouseenter', () => ((sobrevolado = b.dataset.destacar ?? null), pintar()));
      b.addEventListener('mouseleave', () => ((sobrevolado = null), pintar()));
      b.addEventListener('click', () => {
        fijado = fijado === b.dataset.destacar ? null : (b.dataset.destacar ?? null);
        if (!fijado) sobrevolado = null;
        pintar();
      });
    });
  }
</script>
